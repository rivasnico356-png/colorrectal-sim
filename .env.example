# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Base de datos
POSTGRES_DB=colorrectal_sim
POSTGRES_USER=colorrectal
POSTGRES_PASSWORD=cambia_esta_clave
DATABASE_URL=postgresql+psycopg://colorrectal:cambia_esta_clave@db:5432/colorrectal_sim

# Seguridad (genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRETO=genera_un_valor_largo_y_aleatorio
JWT_MINUTOS=60

# Agente tutor de IA (Groq, API compatible con OpenAI). Sin clave el tutor usa la recomendación predefinida.
IA_API_URL=https://api.groq.com/openai/v1/chat/completions
IA_API_KEY=
IA_MODELO_PRINCIPAL=openai/gpt-oss-120b
IA_MODELO_ALTERNATIVO=openai/gpt-oss-20b
# RF-004 4.3: preguntas permitidas al tutor por etapa
TUTOR_MAX_CONSULTAS_ETAPA=3

# Imágenes y videos de los datasets públicos (carpeta local, no se sube al repositorio)
MEDIA_DIR=/app/media

# Seudonimización de la exportación de interacciones (RNF-007)
SAL_SEUDONIMO=genera_otro_valor_aleatorio

# Frontend
CORS_ORIGENES=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Correo por API HTTPS de Brevo (necesario en el plan gratuito de Render, que bloquea SMTP).
# SMTP_REMITENTE debe ser un remitente verificado en Brevo.
BREVO_API_KEY=
