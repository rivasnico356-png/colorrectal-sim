# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Entorno: desarrollo (local) o demostracion (enlace público de Render)
ENTORNO=desarrollo

# Base de datos
POSTGRES_DB=colorrectal_sim
POSTGRES_USER=colorrectal
POSTGRES_PASSWORD=cambia_esta_clave
DATABASE_URL=postgresql+psycopg://colorrectal:cambia_esta_clave@db:5432/colorrectal_sim

# Seguridad (genera cada valor con: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRETO=genera_un_valor_largo_y_aleatorio
# Minutos de validez de la sesión
JWT_MINUTOS_EXPIRACION=60
# RNF-003: clave para cifrar los estudios propios. Si queda vacía se deriva de JWT_SECRETO (solo en desarrollo);
# en cualquier otro entorno defínela y no la cambies después, o los estudios ya guardados no se podrán abrir.
CLAVE_CIFRADO_ESTUDIOS=

# Primer administrador: app/preparar.py lo crea al arrancar si se definen el correo y la contraseña
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Agente tutor de IA (Groq, API compatible con OpenAI). Sin clave el tutor usa la recomendación predefinida.
IA_API_URL=https://api.groq.com/openai/v1/chat/completions
IA_API_KEY=
IA_MODELO_PRINCIPAL=openai/gpt-oss-120b
IA_MODELO_ALTERNATIVO=openai/gpt-oss-20b
# RF-004 4.3: preguntas permitidas al tutor por etapa
TUTOR_MAX_CONSULTAS_ETAPA=3

# Modelo de visión (IE-04): archivo ONNX del release modelo-vision. Sin el archivo, la plataforma funciona sin modelo.
MODELO_VISION_RUTA=modelos/vision.onnx

# Imágenes y videos de los datasets públicos (carpeta local, no se sube al repositorio)
MEDIA_DIR=/app/media

# Casos de demostración: con 1, app/preparar.py publica al arrancar los casos de app/demo
CASO_DEMO=0
# RF-010 en la demostración: con 1 se permite cargar estudios propios en ENTORNO=demostracion (con aviso de uso académico)
ESTUDIOS_EN_DEMO=0

# Seudonimización de la exportación de interacciones (RNF-007)
SAL_SEUDONIMO=genera_otro_valor_aleatorio

# Frontend
CORS_ORIGENES=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Correo por API HTTPS de Brevo (necesario en el plan gratuito de Render, que bloquea SMTP).
# SMTP_REMITENTE debe ser un remitente verificado en Brevo. Sin clave ni servidor, el correo no se envía (desarrollo).
BREVO_API_KEY=
SMTP_REMITENTE=no-responder@colorrectal-sim.local
